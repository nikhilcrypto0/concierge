# Server-only settings for the demo UI. Never prefix these with NEXT_PUBLIC_.
CONCIERGE_API_URL=http://127.0.0.1:8000
# The key after "webapp:" in the API's CLIENT_API_KEYS
CONCIERGE_CLIENT_KEY=
# The key after "support-lead:" in the API's OPERATOR_API_KEYS
CONCIERGE_OPERATOR_KEY=
# Support console login. The password needs 16+ characters, the session secret 32+ (random).
# If either is missing or short, the console and every approval route stay locked.
CONSOLE_PASSWORD=
CONSOLE_SESSION_SECRET=
