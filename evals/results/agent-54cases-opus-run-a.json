      "passed": true,
      "failures": [],
      "outcome": "answered",
      "handoff_reason": null,
      "intent": "question",
      "reply": "On Sundays, human support agents are available from 9 AM to 5 PM Central Time. Just ask the assistant to connect you with a person, and during those hours an agent usually replies within 15 minutes.",
