# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql://localhost:5432/concierge

ANTHROPIC_API_KEY=
PRIMARY_MODEL=claude-opus-5
FALLBACK_MODEL=claude-sonnet-5

# name:key pairs, comma separated. Keys must be >= 16 chars.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIENT_API_KEYS=webapp:replace-with-a-long-random-key
OPERATOR_API_KEYS=support-lead:replace-with-a-different-long-random-key

# Budgets (tokens)
MAX_TOKENS_PER_CONVERSATION=60000
MAX_TOKENS_PER_DAY=2000000
RATE_LIMIT_PER_MINUTE=30

# Optional tracing (https://langfuse.com, free tier or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
